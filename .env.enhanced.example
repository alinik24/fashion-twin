# Enhanced Fashion Twin Configuration
# Copy to .env and configure

# ==================== Photo Scoring Model ====================
# Backend: clip (local), cnn (custom), vlm (API), placeholder
PHOTO_SCORER_BACKEND=clip

# VLM API (for photo scoring via API)
VLM_ENDPOINT=https://api.openai.com/v1/chat/completions
VLM_API_KEY=your_api_key_here
VLM_MODEL=gpt-4-vision-preview

# ==================== Reverse Image Search ====================
# Google Lens (via SerpAPI)
SERPAPI_KEY=your_serpapi_key
GOOGLE_LENS_API=https://serpapi.com/search

# ==================== User Behavior Tracking ====================
BEHAVIOR_TRACKING_ENABLED=true
SCROLL_TIME_THRESHOLD=3.0  # seconds before counting as interest
CLICK_WEIGHT=2.0  # multiplier for click vs scroll
FAVORITE_WEIGHT=5.0  # multiplier for favorite

# ==================== Market Analysis ====================
# Dual method: vinted_db (our database), lens_internet (Google Lens + web)
MARKET_ANALYSIS_METHOD=both  # 'vinted_db', 'lens_internet', or 'both'

# ==================== Vinted Enhanced ====================
# Use enhanced collector with all fields
USE_ENHANCED_COLLECTOR=true

# ==================== User Profile ====================
# Gender preference (for filtering)
USER_GENDER=men  # men, women, kids, unisex

# ==================== Deal Finding ====================
# Simplified - based on ALL attributes
DEAL_SCORE_THRESHOLD=70  # Minimum score to be considered a deal
DEAL_WEIGHTS_PHOTO_SCORE=0.25
DEAL_WEIGHTS_SELLER_TRUST=0.15
DEAL_WEIGHTS_SHIPPING=0.10
DEAL_WEIGHTS_MARKET_PRICE=0.25
DEAL_WEIGHTS_USER_MATCH=0.15
DEAL_WEIGHTS_CONDITION=0.10
