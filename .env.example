# ═══════════════════════════════════════════════════════════════════════════════
# Fashion Twin Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials
# For open-source alternatives, see CONFIGURATION.md

# ─── Database Configuration ───────────────────────────────────────────────────
# PostgreSQL connection string
# Default: Using existing postgres container with dedicated fashion_twin database
# Create database first: docker exec -it postgres psql -U postgres -c "CREATE DATABASE fashion_twin;"
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/fashion_twin

# ─── Qdrant Vector DB ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fashion_items

# ─── Redis Cache (for price tracking, deal alerts) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Vinted Marketplace ───────────────────────────────────────────────────────
VINTED_BASE_URL=https://www.vinted.co.uk
VINTED_SESSION_COOKIE=
# Proxy (optional, for rate limiting bypass)
VINTED_PROXY=

# ─── FashionCLIP (Local - Open Source) ───────────────────────────────────────
# Model: patrickjohncyh/fashion-clip (default, runs locally on CPU/GPU)
EMBEDDING_MODEL=patrickjohncyh/fashion-clip
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32
# Device: cpu, cuda, mps (for Mac M1/M2)
EMBEDDING_DEVICE=cpu

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Choose your provider: openrouter, api_provider, local
# You can mix and match providers for different tasks
LLM_PRIMARY_PROVIDER=openrouter

# ─── OpenRouter (Recommended - Access to 100+ Models) ────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Model Selection
# Vision + Fashion Understanding
OPENROUTER_VISION_MODEL=anthropic/claude-3.5-sonnet
# Fast text generation (descriptions, summaries)
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-70b-instruct
# Reasoning (trend analysis, style profiling)
OPENROUTER_REASONING_MODEL=anthropic/claude-3.5-sonnet
# Budget model (classification, simple tasks)
OPENROUTER_BUDGET_MODEL=meta-llama/llama-3.1-8b-instruct

# ─── External API Provider (Azure OpenAI, OpenAI, Claude, etc.) ──────────────
# Leave empty if using OpenRouter or local only
API_PROVIDER_ENDPOINT=
API_PROVIDER_KEY=
API_PROVIDER_VERSION=
API_PROVIDER_MODEL=

# ─── Text Embeddings API (Optional - Alternative to local FashionCLIP) ───────
# Leave empty to use local FashionCLIP or OpenRouter embeddings
EMBEDDING_API_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-large
EMBEDDING_API_DIM=3072
EMBEDDING_API_VERSION=

# ─── Local LLM (Ollama - Fully Open Source) ──────────────────────────────────
# Install: https://ollama.ai
# Run: ollama pull llama3.1:8b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# ═══════════════════════════════════════════════════════════════════════════════
# Task-Specific Model Assignments
# ═══════════════════════════════════════════════════════════════════════════════
# Map specific tasks to models/providers
# Providers: openrouter, api_provider, local

# Reward Model (RLHF fashion judging, style scoring)
LLM_REWARD_MODEL=anthropic/claude-3.5-sonnet
LLM_REWARD_PROVIDER=openrouter

# Fast Model (real-time preference scoring, quick descriptions)
LLM_FAST_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_FAST_PROVIDER=openrouter

# Reasoning Model (trend extraction, style profile analysis)
LLM_REASONING_MODEL=anthropic/claude-3.5-sonnet
LLM_REASONING_PROVIDER=openrouter

# Deal Analysis Model (price evaluation, deal scoring)
LLM_DEAL_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_DEAL_PROVIDER=openrouter

# ═══════════════════════════════════════════════════════════════════════════════
# Deal Hunting & Price Tracking
# ═══════════════════════════════════════════════════════════════════════════════

# Price tracking settings
PRICE_TRACKING_ENABLED=true
PRICE_CHECK_INTERVAL_HOURS=6
# Alert if price drops below this percentage of average
PRICE_DROP_ALERT_THRESHOLD=0.15
# Minimum price drop amount to trigger alert (in currency)
PRICE_DROP_MIN_AMOUNT=10.0

# Deal scoring weights (must sum to 1.0)
DEAL_SCORE_PRICE_WEIGHT=0.40
DEAL_SCORE_HISTORY_WEIGHT=0.30
DEAL_SCORE_CONDITION_WEIGHT=0.20
DEAL_SCORE_TIME_WEIGHT=0.10

# Deal quality thresholds (0-100)
DEAL_EXCELLENT_THRESHOLD=80
DEAL_GOOD_THRESHOLD=60
DEAL_FAIR_THRESHOLD=40

# Notification settings
DEAL_ALERT_DISCORD_WEBHOOK=
DEAL_ALERT_TELEGRAM_BOT_TOKEN=
DEAL_ALERT_TELEGRAM_CHAT_ID=
DEAL_ALERT_EMAIL=

# ─── Hunter Mode Settings ─────────────────────────────────────────────────────
# Aggressive deal hunting mode
HUNTER_MODE_ENABLED=false
HUNTER_SCAN_INTERVAL_MINUTES=30
HUNTER_MAX_PRICE=200
HUNTER_MIN_DEAL_SCORE=70
# Categories to hunt (comma-separated)
HUNTER_CATEGORIES=jackets,dresses,bags,shoes
# Brands to prioritize (comma-separated)
HUNTER_PRIORITY_BRANDS=chanel,gucci,prada,hermes,celine

# ═══════════════════════════════════════════════════════════════════════════════
# RLHF & Personalization
# ═══════════════════════════════════════════════════════════════════════════════

RLHF_BETA=0.1                   # DPO temperature (higher = stay closer to reference)
RLHF_MIN_PAIRS=20               # Minimum preference pairs before DPO update
RLHF_REWARD_SCALE=10.0          # Reward model output scale (0-10)
RLHF_LLM_JUDGE_ENABLED=true     # Use LLM to auto-label pairs
RLHF_CHECKPOINT_DIR=./artefacts/rlhf

# ─── Behavioral Tracking ──────────────────────────────────────────────────────
TRACKER_DEFAULT_DOMAIN=fashion
TRACKER_DWELL_THRESHOLD_SEC=3.0  # dwell >= this = positive signal
TRACKER_SESSION_FILE=./data/tracker_session.json
TRACKER_CONSENT_FILE=./data/consent.json
TRACKER_ENABLED_DOMAINS=fashion

# ─── Style Profile & Rules ────────────────────────────────────────────────────
RULES_FILE=./data/user_rules.json
STYLE_PROFILE_FILE=./data/style_profile.json

# ─── Trend Scraping ───────────────────────────────────────────────────────────
TREND_REFRESH_HOURS=24
# Sources: vogue, lyst, pinterest_rss, vinted_trending
TREND_SOURCES=vogue,lyst,vinted_trending
# Use LLM to extract trending items from articles
TREND_LLM_EXTRACTION=true

# ═══════════════════════════════════════════════════════════════════════════════
# Scraping Configuration
# ═══════════════════════════════════════════════════════════════════════════════

SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=4.0
SCRAPE_MAX_PAGES=10
# Use rotating proxies (comma-separated)
SCRAPE_PROXIES=
# User agents rotation
SCRAPE_ROTATE_USER_AGENTS=true

# ═══════════════════════════════════════════════════════════════════════════════
# Recommendation Engine
# ═══════════════════════════════════════════════════════════════════════════════

# LightFM collaborative filtering
LIGHTFM_EPOCHS=30
LIGHTFM_NUM_THREADS=4
LIGHTFM_LEARNING_RATE=0.05
LIGHTFM_LOSS=warp  # warp, bpr, or logistic

# Hybrid ranking (collaborative + content + bandit)
RANKER_COLLABORATIVE_WEIGHT=0.4
RANKER_CONTENT_WEIGHT=0.3
RANKER_BANDIT_WEIGHT=0.3

# Model artifacts
MODEL_SAVE_DIR=./artefacts

# ═══════════════════════════════════════════════════════════════════════════════
# Advanced Features
# ═══════════════════════════════════════════════════════════════════════════════

# Outfit compatibility scoring
OUTFIT_COMPATIBILITY_ENABLED=false
OUTFIT_COMPATIBILITY_MODEL=clip  # clip or custom

# Attribute extraction (color, material, style)
ATTRIBUTE_EXTRACTION_ENABLED=true
# Model: fashionpedia, deepfashion2, or api
ATTRIBUTE_EXTRACTION_MODEL=fashionpedia

# Material sustainability scoring
SUSTAINABILITY_SCORING_ENABLED=false
SUSTAINABILITY_BLOCKLIST=polyester,acrylic,nylon

# Auto-purchase (use with extreme caution!)
AUTO_PURCHASE_ENABLED=false
AUTO_PURCHASE_MAX_PRICE=50
AUTO_PURCHASE_MIN_SCORE=90

# ═══════════════════════════════════════════════════════════════════════════════
# Logging & Monitoring
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/fashion_twin.log
# Sentry error tracking (optional)
SENTRY_DSN=

# Performance monitoring
PERFORMANCE_MONITORING_ENABLED=false
SLOW_QUERY_THRESHOLD_MS=1000
